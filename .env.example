# Server-only Vercel environment variables. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_IDS=
PRACTICE_TOKEN_SECRET=

# Google AI Studio Gemini Free-Tier Model Integration
# Get a free API key at https://aistudio.google.com without adding a credit card.
GEMINI_API_KEY=
# Optional; supported free-tier flash models: gemini-3.5-flash-lite (default), gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Groq Free-Tier Integration (High-speed open-source failover)
# Get a free API key at https://console.groq.com without adding a credit card.
# Automatic failover supported models: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_API_KEY=
